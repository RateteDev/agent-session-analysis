// ============================================================
//  エージェント会話アーカイブ形式  v0.2
// ============================================================
//
// 【目的】
//   harnessやWebChatを問わず会話を自己完結した形で保存し、いつでも読み返せること。
//   content=fullでは、各itemがcontextへ持ち込んだtoken量も分析できること。
//
// 【本文の扱い】
//   マスクは行わず生のまま保存する。archiveは、含まれる最も機微な内容と同じ扱いを要する。
//
// 【v0.1との互換性】
//   v0.1はcontent keyを持たず、常にv0.2のcontent=fullと同じevent形式だった。
//   v0.1ファイルは変更せず、そのままv0.1として扱う。
//
// ------------------------------------------------------------
//  ファイル名
// ------------------------------------------------------------
//   {YYYYMMDDThhmmssZ}-{harness}-{sessionId}.{content}.jsonl
//
//   例:
//     20260901T113414Z-opencode-ses_example.full.jsonl
//     20260901T113414Z-opencode-ses_example.messages.jsonl
//
//   - 先頭は、そのファイルで最初に時刻を持つrecordの時刻。UTC、ISO 8601基本形式。
//   - どのrecordも時刻を持たなければsource sessionの開始時刻を用いる。
//   - session IDはファイル名を正本とする。content modeの正本はmeta.contentで、suffixはその反映。
//
// ------------------------------------------------------------
//  共通規約
// ------------------------------------------------------------
//   - 1行1JSON。1行目はmeta、2行目以降はmeta.contentに対応するrecord。
//   - data recordはseqの昇順で並び、seqは1始まりでfile内に隙間を持たない。
//   - 同じrecord種別の全行は全keyを持つ。欠損はscalarならnull。空文字で代用しない。
//   - 導出できる割合、合計、所要時間、carry回数は持たない。


// ============================================================
//  1行目: meta
// ============================================================
{
  "record": "meta",
  "schema_version": "0.2",

  // full | messages
  "content": "full",

  // source harnessを識別する値。
  "harness": "opencode",

  // 推論providerがfile内で一意ならそのID。複数または不明ならnull。
  "provider": "openai",

  // sourceが持つsession名。なければnull。
  "title": "サンドボックスのベンチマーク環境構築計画",

  // 会話単位のabsolute URI。queryとfragmentは除去する。なければnull。
  // archive自身の置き場所は、移動した瞬間に嘘になるため入れない。
  "source": "https://example.test/session/ses_example",

  // 抽出時刻。UTCのRFC 3339。
  "extracted_at": "2026-09-02T00:00:00Z"
}


// ============================================================
//  content=messages: 2行目以降はmessage
// ============================================================
//   人間のuser発言とassistantの公開text blockだけをsource順で保存する。
//
//   - userはsourceのdisplay textを優先し、なければmodel-facing textを使う。
//   - assistantの複数text blockは結合せず、1 blockを1 recordにする。
//   - reasoning、tool入出力、synthetic、system、skillは書かない。
//   - 本文は要約、修正、マスクしない。空の本文はrecordを作らない。
{
  "record": "message",
  "seq": 1,
  "ts": "2026-09-01T11:34:14.129Z",
  "role": "user",
  "content": "発言本文"
}


// ============================================================
//  content=full: 1file = 1context
// ============================================================
//   contextが作り直された場合は別fileとする。
//
//   - compactionはmessages配列が置き換わるため別context。
//   - subagent内部の往復はparent contextへ入らないため別context。
//   - rewindで破棄されたitemは書かず、残ったrequestをreqで連番にする。
//
//   結果としてtoken差分と不変条件は各file内で閉じる。
//
// ------------------------------------------------------------
//  content=full: 2行目以降はevent
// ------------------------------------------------------------
//   1行 = contextへ入った1 content block。
{
  "record": "event",

  // item通し番号。1始まりでfile内に隙間を持たない。
  "seq": 60,

  // このitemが初めてcontextへ入った推論request番号。まだ入っていなければnull。
  "req": 26,

  // itemの時刻。取得できなければnull。UTCのRFC 3339。
  "ts": "2026-09-01T11:39:24.880Z",

  // このitemをcontextへ入れたrequestのmodel。不明またはreq=nullならnull。
  "model": "gpt-5.6-sol",

  "block": {
    // model APIへ渡されたrole。roleを持たない初期prompt等はnull。
    "role": "tool",

    // text | thinking | tool_use | tool_result | image
    "type": "tool_result",

    // tool_use/tool_resultのtool名。他はnull。
    "tool": "shell",

    // 全文。取得不能またはbinaryならnull。
    // tool_useのobject引数はJSON文字列にするが、contentが常にJSONとは限らない。
    "content": "Command exited with code 0."
  },

  // このitemがcontextへ持ち込んだtoken量。sourceがusageを報告しない場合はnull。
  "tokens": {
    "value": 6276,

    // exact      itemに一意に対応する測定値
    // tokenized  個別tokenize後、既知の合計へ正規化した推定値
    // byte_ratio byte数比で既知の合計へ正規化した推定値
    "method": "exact"
  }
}
